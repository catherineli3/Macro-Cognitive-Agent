# ===========================================
# Macro Research Agent v3.0 — Environment Variables
# ===========================================
# Copy to .env and fill in values:
#   cp .env.example .env
# Without .env, the agent uses free sources (Sina + WorldBank) + synthetic fallbacks.

# --- Application ---
APP_ENV=development
APP_DEBUG=true

# --- Server (optional API mode) ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/macro_research
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./data/macro_research.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- LLM Provider: Kimi (Moonshot API, OpenAI-compatible) ---
# The agent works fully deterministically WITHOUT an LLM.
# To enable LLM-powered narrative generation, set llm.enabled=true in configs/settings.yaml
# and fill in the following:
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API_KEY=sk-your-moonshot-key-here
# KIMI_MODEL=moonshot-v1-8k

# --- LLM Provider (for LangChain/LangGraph, optional, legacy) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# --- External Data Sources ---
# FRED API — register at https://fred.stlouisfed.org/docs/api/api_key.html
# Unlocks: real-time GDP, CPI, unemployment, industrial production, interest rates
# FRED_API_KEY=

# World Bank — NO API KEY REQUIRED (GDP, CPI, unemployment via World Bank API)
# WORLD_BANK_API_KEY=

# Sina Finance — NO API KEY REQUIRED (real-time US market prices, works from China)

# Twitter/X Bearer Token — for sentiment analysis module (optional)
# TWITTER_BEARER_TOKEN=
